{
  "info": {
    "name": "CampusSpace",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order (room -> user -> booking). Booking dates are generated by the collection pre-request script."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh future slots on every run (UTC), so the 'start in the future' rule always passes",
          "var d = new Date(); d.setUTCDate(d.getUTCDate() + 30); d.setUTCHours(14, 0, 0, 0);",
          "var h = 3600*1000;",
          "function iso(ms){ return new Date(ms).toISOString().replace('.000Z','Z'); }",
          "var t = d.getTime();",
          "pm.collectionVariables.set('slotA_start', iso(t));",
          "pm.collectionVariables.set('slotA_end', iso(t + h));",
          "pm.collectionVariables.set('slotB_end', iso(t + 2*h));",
          "pm.collectionVariables.set('slotOverlap_start', iso(t + h/2));",
          "pm.collectionVariables.set('slotOverlap_end', iso(t + 3*h/2));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "roomUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "userUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "bookingUrl",
      "value": "http://localhost:8084"
    }
  ],
